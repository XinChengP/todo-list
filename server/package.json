{
  "name": "todo-sync-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute todo-db --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute todo-db --remote --file schema.sql",
    "smoke": "bash scripts/smoke.sh http://127.0.0.1:7777 dev-local-token"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
